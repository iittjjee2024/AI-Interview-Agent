# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# LLM Configuration
# Supported providers: openrouter, groq, openai, gemini, ollama
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Interview Configuration
MIN_QUESTIONS=8
TARGET_QUESTIONS=10
MAX_QUESTIONS=15
MIN_CURRICULUM_DAYS=4
QUESTION_SIMILARITY_THRESHOLD=0.85

# Optional: Vector DB (not required for in-memory mode)
VECTOR_DB_PROVIDER=memory
VECTOR_DB_URL=

# Optional: Redis (not required for in-memory mode)
REDIS_URL=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
